# ─────────────────────────────────────────────────────────────────────────────
# IFC BIM Hub v2 — Backend · Variables de entorno
# Copia este archivo como `.env` en backend/ y ajusta los valores.
# Todas las variables son OPCIONALES: sin .env el backend arranca con
# los defaults indicados abajo (entorno de desarrollo local).
# Cargado por core/config.py (parser propio, sin python-dotenv).
# ─────────────────────────────────────────────────────────────────────────────

# URL base de PocketBase (sin barra final)
POCKETBASE_URL=http://127.0.0.1:8090

# Orígenes permitidos para CORS, separados por comas (frontend Next.js)
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Máximo de modelos IFC abiertos simultáneamente en el pool LRU.
# Cada IFC grande puede ocupar cientos de MB en RAM: subir con cuidado.
MODEL_CACHE_MAX=4

# TTL (segundos) de cada modelo cacheado. 0 = sin caducidad (solo LRU/mtime).
MODEL_CACHE_TTL_S=900

# Timeout (segundos) de TODAS las llamadas a PocketBase
PB_TIMEOUT_S=5

# ⚠️ SEGURIDAD — Carpetas raíz donde el backend puede leer y ESCRIBIR IFC.
# Rutas absolutas separadas por ';' (os.pathsep en Windows).
#
# Dejarla VACÍA significa MODO PERMISIVO: el backend acepta cualquier ruta a la
# que llegue tu usuario de Windows. Como el backend escucha en 127.0.0.1:8020,
# cualquier página web que visites puede hacer POST a /api/ifc/delete y borrar
# archivos tuyos. DEFÍNELA SIEMPRE.
#
# Se expanden %VARIABLES% y ~, así que el mismo valor sirve en cualquier PC.
# Convención BIMRail: una carpeta EXPORT con subcarpetas por fecha "AAMMDD IFC".
IFC_ALLOWED_ROOTS=%USERPROFILE%\OneDrive - NUPD COMPUTER S.L\Documentos\EXPORT

# Nivel de logging global: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Etapa de entrega activa del proyecto (midp_mapping guarda el histórico de
# todas las etapas sin borrar filas). Cambiar al avanzar de etapa: MOI, MOM, ...
MIDP_ETAPA_ACTIVA=MOM
